    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@model IEnumerable<Micon.CMS.Models.Page>
@{
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PageCategory.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Modified)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PageCategory.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Modified)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">編集</a> |
                    <a asp-action="Copy" asp-route-id="@item.Id">コピー</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">削除</a> |
                    <a asp-action="Open" asp-route-id="@item.Id">公開</a> |
                    <a asp-action="Close" asp-route-id="@item.Id">非公開</a>
                </td>
            </tr>
        }
    </tbody>
</table>
